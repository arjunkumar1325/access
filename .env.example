# AccessAI Environment Variables Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Database Configuration (defaults to SQLite in instance/accessai.db)
# To use PostgreSQL in future: postgresql://username:password@localhost:5432/accessaidb
DATABASE_URL=sqlite:///instance/accessai.db

# Campus or Neighborhood Map Area (Place name or center coordinates)
ACCESSAI_PLACE=Bengaluru, Karnataka, India
